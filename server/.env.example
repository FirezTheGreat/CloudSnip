# ===========================================
# GCP Project
# ===========================================
GCP_PROJECT_ID=your-project-id
GCP_ZONE=us-central1-a
GCP_REGION=us-central1
GCP_BILLING_ACCOUNT_ID=01XXXX-XXXXXX-XXXXXX

# Optional: path to service account JSON key.
# If omitted, uses Application Default Credentials:
#   gcloud auth application-default login
# GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json

# ===========================================
# MongoDB (Atlas or local)
# ===========================================
MONGODB_URI=mongodb://127.0.0.1:27017/cloudsnip

# ===========================================
# Python ML Service (Isolation Forest)
# ===========================================
ML_SERVICE_URL=http://localhost:5001

# ===========================================
# Anomaly Detection Thresholds
# ===========================================
IDLE_CPU_THRESHOLD=5           # CPU % below which a VM is considered idle
IDLE_DURATION_MINUTES=30       # Sustained idle minutes before flagging
FUNCTION_SPIKE_MULTIPLIER=10   # Invocations > N × baseline = spike
ANOMALY_SCORE_THRESHOLD=0.7    # ML score above which anomaly is confirmed (0-1)
MAX_FUNCTION_INSTANCES=5       # Cap applied when capping a runaway function

# ===========================================
# Notifications (optional — works without)
# ===========================================
# Create at: https://api.slack.com/apps → Incoming Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...

# URL shown in Slack notification buttons → links back to your dashboard
DASHBOARD_URL=http://localhost:5173

# ===========================================
# Server
# ===========================================
PORT=4000
DRY_RUN=false    # true = log actions only, no real GCP API calls

# ===========================================
# Cron schedules (cron expression)
# ===========================================
CRON_SCHEDULE=*/5 * * * *        # Telemetry pipeline (default: every 5 min)
SIM_CRON_SCHEDULE=*/20 * * * *   # Auto-simulation (default: every 20 min)

# ===========================================
# Demo cloud function URL
# (deployed to GCP via cloud-function-demo/)
# ===========================================
CLOUD_FUNCTION_URL=https://YOUR_REGION-YOUR_PROJECT.cloudfunctions.net/cloudsnipDemo
