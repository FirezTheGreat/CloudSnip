# ===========================================
# GCP Credentials
# Create a service account with the required roles
# See docs/GCP_SETUP.md for step-by-step guide
# ===========================================
GCP_PROJECT_ID=your-project-id
GCP_ZONE=us-central1-a
GCP_REGION=us-central1
GCP_BILLING_ACCOUNT_ID=01XXXX-XXXXXX-XXXXXX

# Path to the service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json

# ===========================================
# MongoDB
# Default credentials match docker-compose.yml
# ===========================================
MONGODB_URI=mongodb://localhost:27017/costintel

# ===========================================
# ML Service
# Python Flask service running Isolation Forest
# ===========================================
ML_SERVICE_URL=http://localhost:5001

# ===========================================
# Anomaly Detection Thresholds
# Tune these for your demo environment
# ===========================================

# Compute Engine idle detection: CPU below this % for IDLE_DURATION_MINUTES = idle
IDLE_CPU_THRESHOLD=5
IDLE_DURATION_MINUTES=30

# Cloud Functions spike detection: invocations exceeding this multiple of average = spike
FUNCTION_SPIKE_MULTIPLIER=10

# ML anomaly score: above this = confirmed anomaly (0.0 to 1.0)
ANOMALY_SCORE_THRESHOLD=0.7

# Cloud Functions max instances: set this when capping a runaway function
MAX_FUNCTION_INSTANCES=5

# ===========================================
# Server Configuration
# ===========================================
PORT=4000
WS_PORT=4001

# ===========================================
# Safety
# Set to "true" to log actions without executing them
# ===========================================
DRY_RUN=false

# ===========================================
# Polling Interval (cron expression)
# Default: every 5 minutes
# ===========================================
CRON_SCHEDULE=*/5 * * * *
