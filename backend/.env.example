# ===========================================
# AWS Credentials
# Create an IAM user with the CostIntelPolicy
# See docs/AWS_SETUP.md for step-by-step guide
# ===========================================
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_REGION=us-east-1

# ===========================================
# TimescaleDB
# Default credentials match docker-compose.yml
# ===========================================
DATABASE_URL=postgresql://costintel:password@localhost:5432/costintel

# ===========================================
# ML Service
# Python Flask service running Isolation Forest
# ===========================================
ML_SERVICE_URL=http://localhost:5001

# ===========================================
# Anomaly Detection Thresholds
# Tune these for your demo environment
# ===========================================

# EC2 idle detection: CPU below this % for IDLE_DURATION_MINUTES = idle
IDLE_CPU_THRESHOLD=5
IDLE_DURATION_MINUTES=30

# Lambda spike detection: invocations exceeding this multiple of average = spike
LAMBDA_SPIKE_MULTIPLIER=10

# ML anomaly score: above this = confirmed anomaly (0.0 to 1.0)
ANOMALY_SCORE_THRESHOLD=0.7

# Lambda concurrency cap: set this when capping a runaway function
MAX_LAMBDA_CONCURRENCY=5

# ===========================================
# Server Configuration
# ===========================================
PORT=4000
WS_PORT=4001

# ===========================================
# Safety
# Set to "true" to log actions without executing them
# ===========================================
DRY_RUN=false

# ===========================================
# Polling Interval (cron expression)
# Default: every 5 minutes
# ===========================================
CRON_SCHEDULE=*/5 * * * *
